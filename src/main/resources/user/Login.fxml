<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="740.0" prefWidth="1280.0"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.user.controller.LoginController"
           stylesheets="@login_style.css"
           styleClass="auth-root">

    <VBox alignment="CENTER" spacing="22.0">
        <VBox spacing="16.0"
              alignment="CENTER"
              styleClass="auth-card"
              maxWidth="480.0"
              prefWidth="480.0">

            <padding>
                <Insets top="28.0" right="32.0" bottom="28.0" left="32.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="brand-box">
                <Label text="❤" styleClass="brand-icon"/>

                <VBox spacing="2.0">
                    <Label text="Sosi" styleClass="brand-title"/>
                    <Label text="Espace Santé" styleClass="brand-subtitle"/>
                </VBox>
            </HBox>

            <VBox spacing="4.0" alignment="CENTER">
                <Label text="Connexion" styleClass="page-title-auth"/>
                <Label text="Connectez-vous à votre espace santé" styleClass="page-subtitle-auth"/>
            </VBox>

            <VBox spacing="8.0">
                <Label text="Email" styleClass="field-label"/>
                <TextField fx:id="emailField"
                           promptText="votre@email.com"
                           styleClass="auth-input"/>
            </VBox>

            <VBox spacing="8.0">
                <Label text="Mot de passe" styleClass="field-label"/>
                <PasswordField fx:id="passwordField"
                               promptText="Votre mot de passe"
                               styleClass="auth-input"/>
            </VBox>

            <CheckBox fx:id="rememberMeCheckBox"
                      text="Se souvenir de moi"
                      styleClass="check-auth"/>

            <Label fx:id="errorLabel"
                   text=""
                   styleClass="error-label"/>

            <Button text="Se connecter"
                    onAction="#handleLogin"
                    prefWidth="410.0"
                    styleClass="primary-button-auth"/>

            <Button text="Continuer avec Google"
                    onAction="#handleGoogleLogin"
                    prefWidth="410.0"
                    styleClass="primary-button-auth"/>

            <HBox alignment="CENTER" spacing="5.0">
                <Label text="Pas encore de compte ?" styleClass="helper-line"/>

                <Hyperlink text="S'inscrire"
                           onAction="#goToRegister"
                           styleClass="link-auth"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>