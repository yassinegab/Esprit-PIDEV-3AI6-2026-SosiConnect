<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.user.backoffice.controller.AdminUserViewController"
      stylesheets="@../user_admin_style.css"
      spacing="18.0"
      styleClass="dialog-root">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT">
        <Label text="Détail Utilisateur" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Fermer" onAction="#handleClose" styleClass="secondary-button"/>
    </HBox>

    <Label fx:id="fullNameLabel" text="Nom Prénom" styleClass="user-big-name"/>
    <Label fx:id="roleLabel" text="Rôle" styleClass="role-chip-admin"/>

    <VBox spacing="14.0" styleClass="detail-card">
        <Label fx:id="emailLabel" text="Email"/>
        <Label fx:id="telephoneLabel" text="Téléphone"/>
        <Label fx:id="ageLabel" text="Âge"/>
        <Label fx:id="sexeLabel" text="Sexe"/>
        <Label fx:id="poidsLabel" text="Poids"/>
        <Label fx:id="tailleLabel" text="Taille"/>
        <Label fx:id="handicapLabel" text="Handicap"/>
    </VBox>

</VBox>