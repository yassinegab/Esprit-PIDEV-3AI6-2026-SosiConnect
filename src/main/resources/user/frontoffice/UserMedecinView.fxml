<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.user.frontoffice.controller.UserMedecinController"
      stylesheets="@../user_medecin_style.css"
      spacing="24.0"
      styleClass="med-root">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <VBox spacing="6.0">
        <Label text="Tableau de Bord Médecin" styleClass="page-title"/>
        <Label text="Vue d'ensemble de vos patients" styleClass="page-subtitle"/>
    </VBox>

    <HBox spacing="20.0">
        <HBox spacing="18.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="👥" styleClass="stat-icon"/>

            <VBox spacing="4.0">
                <Label text="Total Patients" styleClass="stat-label"/>
                <Label fx:id="totalPatientsLabel" text="0" styleClass="stat-value"/>
            </VBox>
        </HBox>

        <HBox spacing="18.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="📄" styleClass="stat-icon"/>

            <VBox spacing="4.0">
                <Label text="Dossiers Médicaux" styleClass="stat-label"/>
                <Label fx:id="totalDossiersLabel" text="0" styleClass="stat-value"/>
            </VBox>
        </HBox>

        <HBox spacing="18.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="⚠" styleClass="stat-icon-red"/>

            <VBox spacing="4.0">
                <Label text="Maladies Chroniques" styleClass="stat-label"/>
                <Label fx:id="totalMaladiesLabel" text="0" styleClass="stat-value"/>
            </VBox>
        </HBox>

        <HBox spacing="18.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label text="◌" styleClass="stat-icon-orange"/>

            <VBox spacing="4.0">
                <Label text="Allergies Signalées" styleClass="stat-label"/>
                <Label fx:id="totalAllergiesLabel" text="0" styleClass="stat-value"/>
            </VBox>
        </HBox>
    </HBox>

    <HBox spacing="20.0">
        <VBox spacing="16.0" styleClass="panel-card" HBox.hgrow="ALWAYS">
            <Label text="Niveaux d'Activité des Patients" styleClass="section-title"/>

            <BarChart fx:id="activiteBarChart" legendVisible="false" prefHeight="360.0">
                <xAxis>
                    <CategoryAxis/>
                </xAxis>
                <yAxis>
                    <NumberAxis/>
                </yAxis>
            </BarChart>
        </VBox>

        <VBox spacing="16.0" styleClass="panel-card" prefWidth="420.0">
            <Label text="Statistiques Rapides" styleClass="section-title"/>

            <HBox styleClass="quick-stat-row">
                <Label text="Age moyen" styleClass="quick-stat-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="ageMoyenLabel" text="0 ans" styleClass="quick-stat-value"/>
            </HBox>

            <HBox styleClass="quick-stat-row">
                <Label text="Poids moyen" styleClass="quick-stat-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="poidsMoyenLabel" text="0 kg" styleClass="quick-stat-value"/>
            </HBox>

            <HBox styleClass="quick-stat-row">
                <Label text="Hommes / Femmes" styleClass="quick-stat-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="hommesFemmesLabel" text="0 / 0" styleClass="quick-stat-value"/>
            </HBox>

            <HBox styleClass="quick-stat-row">
                <Label text="Avec handicap" styleClass="quick-stat-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="handicapLabel" text="0" styleClass="quick-stat-value"/>
            </HBox>
        </VBox>
    </HBox>

    <HBox spacing="16.0" alignment="CENTER_LEFT">
        <TextField fx:id="searchField"
                   promptText="Rechercher un patient..."
                   onKeyReleased="#handleSearch"
                   styleClass="search-field"
                   prefWidth="560.0"/>

        <Label fx:id="countPatientsLabel" text="0 patient(s)" styleClass="count-chip"/>
    </HBox>

    <VBox spacing="12.0" styleClass="table-panel">
        <TableView fx:id="patientsTable" prefHeight="480.0">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="70.0"/>
                <TableColumn fx:id="nomColumn" text="Nom Complet" prefWidth="210.0"/>
                <TableColumn fx:id="emailColumn" text="Email" prefWidth="260.0"/>
                <TableColumn fx:id="telephoneColumn" text="Téléphone" prefWidth="180.0"/>
                <TableColumn fx:id="ageColumn" text="Age" prefWidth="100.0"/>
                <TableColumn fx:id="sexeColumn" text="Sexe" prefWidth="100.0"/>
                <TableColumn fx:id="dossierColumn" text="Dossier Médical" prefWidth="150.0"/>
            </columns>
        </TableView>
    </VBox>

</VBox>