<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.user.frontoffice.controller.UserControllerClientController"
      style="-fx-background-color: #fcfbfd; -fx-padding: 30;"
      spacing="20.0">

    <!-- Page Header Banner -->
    <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: white; -fx-background-radius: 24; -fx-padding: 24 32; -fx-effect: dropshadow(three-pass-box, rgba(0, 0, 0, 0.03), 20, 0, 0, 5); -fx-border-color: #f1f5f9; -fx-border-width: 1; -fx-border-radius: 24;">
        <VBox alignment="CENTER" style="-fx-background-color: #faf5ff; -fx-background-radius: 16; -fx-min-width: 56; -fx-min-height: 56; -fx-border-color: #f3e8ff; -fx-border-radius: 16;">
            <Label text="👤" style="-fx-font-size: 26px;" />
        </VBox>
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Mon Profil" style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: #1e293b; -fx-font-family: 'Segoe UI', sans-serif;" />
            <Label text="Gérez vos informations personnelles et vos paramètres de compte." style="-fx-font-size: 13px; -fx-text-fill: #64748b; -fx-font-weight: 600; -fx-font-family: 'Segoe UI', sans-serif;" wrapText="true" />
        </VBox>
    </HBox>

    <!-- Content Card -->
    <VBox style="-fx-background-color: white; -fx-background-radius: 24; -fx-padding: 40; -fx-effect: dropshadow(three-pass-box, rgba(192, 132, 252, 0.04), 24, 0, 0, 8); -fx-border-color: #f1f5f9; -fx-border-width: 1; -fx-border-radius: 24;" VBox.vgrow="ALWAYS" alignment="CENTER" spacing="20">
        <Label text="🚧" style="-fx-font-size: 40px;" />
        <Label text="Espace Client en cours de construction" style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #1e293b; -fx-font-family: 'Segoe UI', sans-serif;" />
        <Label text="Vos informations personnelles apparaîtront bientôt ici." style="-fx-font-size: 14px; -fx-text-fill: #94a3b8; -fx-font-family: 'Segoe UI', sans-serif;" />
    </VBox>

</VBox>
