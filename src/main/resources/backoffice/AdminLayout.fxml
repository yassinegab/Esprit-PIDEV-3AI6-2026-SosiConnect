<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.control.Separator?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane prefHeight="820.0" prefWidth="1280.0"
            styleClass="admin-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.backoffice.controller.AdminBaseController">

    <stylesheets>
        <URL value="@admin_style.css"/>
    </stylesheets>

    <!-- ═══════════════════════════════════════ -->
    <!--  ICON-ONLY SIDEBAR (left, 64px)         -->
    <!-- ═══════════════════════════════════════ -->
    <left>
        <VBox styleClass="sidebar" alignment="CENTER" BorderPane.alignment="CENTER">

            <!-- Logo Section -->
            <StackPane styleClass="sidebar-logo-container">
                <ImageView fitWidth="32" preserveRatio="true">
                    <Image url="@../assets/images/sosi_logo.png" />
                </ImageView>
            </StackPane>

            <!-- Thin separator -->
            <Region styleClass="sidebar-separator"/>

            <!-- Nav icons (fills remaining vertical space) -->
            <VBox VBox.vgrow="ALWAYS" alignment="TOP_CENTER" spacing="8" style="-fx-padding: 12 0;">
                <Button fx:id="btnDashboard" styleClass="icon-nav-btn,active" onAction="#showDashboard">
                    <tooltip><Tooltip text="Dashboard"/></tooltip>
                    <graphic>
                        <SVGPath content="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z" 
                                 fill="#475569" styleClass="icon-nav-svg"/>
                    </graphic>
                </Button>
                
                <Button fx:id="btnUsers" styleClass="icon-nav-btn" onAction="#showUserAdmin">
                    <tooltip><Tooltip text="Utilisateurs"/></tooltip>
                    <graphic>
                        <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" 
                                 fill="#475569" styleClass="icon-nav-svg"/>
                    </graphic>
                </Button>

                <Region styleClass="icon-nav-divider"/>

                <Button fx:id="btnWellbeing" styleClass="icon-nav-btn" onAction="#showWellbeingAdmin">
                    <tooltip><Tooltip text="Bien-être Mental"/></tooltip>
                    <graphic>
                        <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm4.5-9h-2.32l-.83-2.5a.5.5 0 0 0-.95 0l-.83 2.5H9.5a.5.5 0 0 0 0 1h2.32l.83 2.5a.5.5 0 0 0 .95 0l.83-2.5h2.32a.5.5 0 0 0 0-1z" 
                                 fill="#475569" styleClass="icon-nav-svg"/>
                    </graphic>
                </Button>
                
                <Button fx:id="btnMedical" styleClass="icon-nav-btn" onAction="#showMedicalAdmin">
                    <tooltip><Tooltip text="Services Médicaux"/></tooltip>
                    <graphic>
                        <SVGPath content="M19 3H5c-1.1 0-1.99.9-1.99 2L3 19c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-1 11h-4v4h-4v-4H6v-4h4V6h4v4h4v4z" 
                                 fill="#475569" styleClass="icon-nav-svg"/>
                    </graphic>
                </Button>
                
                <Button fx:id="btnAide" styleClass="icon-nav-btn" onAction="#showAideAdmin">
                    <tooltip><Tooltip text="Aide &amp; Don"/></tooltip>
                    <graphic>
                        <SVGPath content="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" 
                                 fill="#475569" styleClass="icon-nav-svg"/>
                    </graphic>
                </Button>
                
                <Button fx:id="btnAlertes" styleClass="icon-nav-btn" onAction="#showAlertesAdmin">
                    <tooltip><Tooltip text="Alertes d'Urgence"/></tooltip>
                    <graphic>
                        <SVGPath content="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z" 
                                 fill="#475569" styleClass="icon-nav-svg"/>
                    </graphic>
                </Button>
                
                <Button fx:id="btnCycle" styleClass="icon-nav-btn" onAction="#showCycleAdmin">
                    <tooltip><Tooltip text="Suivi Cycle"/></tooltip>
                    <graphic>
                        <SVGPath content="M12 2c-5.33 4.55-8 8.48-8 11.8 0 4.98 3.8 8.2 8 8.2s8-3.22 8-8.2c0-3.32-2.67-7.25-8-11.8zm0 18c-3.33 0-5.91-2.51-5.91-6.13 0-2.77 2.25-6.12 5.91-9.41 3.66 3.3 5.91 6.64 5.91 9.41 0 3.62-2.58 6.13-5.91 6.13z" 
                                 fill="#475569" styleClass="icon-nav-svg"/>
                    </graphic>
                </Button>
            </VBox>

            <!-- Bottom: logout -->
            <Region styleClass="sidebar-separator"/>
            <Button styleClass="icon-nav-btn,logout-icon-btn" onAction="#handleLogout">
                <tooltip><Tooltip text="Déconnexion"/></tooltip>
                <graphic>
                    <SVGPath content="M13 3h-2v10h2V3zm4.83 2.17l-1.42 1.42C17.99 7.86 19 9.81 19 12c0 3.87-3.13 7-7 7s-7-3.13-7-7c0-2.19 1.01-4.14 2.58-5.42L6.17 5.17C4.23 6.82 3 9.26 3 12c0 4.97 4.03 9 9 9s9-4.03 9-9c0-2.74-1.23-5.18-3.17-6.83z" 
                             fill="#475569" styleClass="icon-nav-svg"/>
                </graphic>
            </Button>
            <VBox.margin>
                <Insets bottom="12"/>
            </VBox.margin>
        </VBox>
    </left>

    <!-- ═══════════════════════════════════════ -->
    <!--  RIGHT SIDE: top bar + content          -->
    <!-- ═══════════════════════════════════════ -->
    <center>
        <VBox spacing="0">

            <!-- Top Bar -->
            <HBox styleClass="admin-topbar" alignment="CENTER_LEFT" spacing="16">
                <padding><Insets left="28" right="28"/></padding>

                <!-- Search pill (grows) -->
                <HBox styleClass="admin-search-pill" alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS">
                    <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" 
                             fill="#94a3b8" scaleX="0.9" scaleY="0.9"/>
                    <TextField promptText="Rechercher dans le système…"
                               styleClass="admin-search-field"
                               maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button styleClass="admin-icon-btn">
                    <graphic>
                        <SVGPath content="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z" 
                                 fill="#64748b" scaleX="0.9" scaleY="0.9" styleClass="topbar-svg"/>
                    </graphic>
                </Button>
                <Button styleClass="admin-icon-btn">
                    <graphic>
                        <SVGPath content="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" 
                                 fill="#64748b" scaleX="0.9" scaleY="0.9" styleClass="topbar-svg"/>
                    </graphic>
                </Button>

                <Region styleClass="admin-v-divider"/>

                <!-- Admin profile chip -->
                <HBox styleClass="admin-profile-chip" alignment="CENTER" spacing="10">
                    <StackPane styleClass="admin-avatar-circle">
                        <Label text="AD" styleClass="admin-avatar-letters"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="0">
                        <Label text="Admin User"           styleClass="admin-profile-name"/>
                        <Label text="Super Administrateur" styleClass="admin-profile-role"/>
                    </VBox>
                </HBox>
            </HBox>

            <!-- Dynamic Content Area -->
            <StackPane fx:id="adminContentArea" VBox.vgrow="ALWAYS" styleClass="admin-content-area"/>
        </VBox>
    </center>

</BorderPane>
