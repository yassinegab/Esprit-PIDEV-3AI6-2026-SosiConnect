<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.aideEtdon.frontoffice.controller.DonReactionController"
      alignment="TOP_CENTER" spacing="0"
      stylesheets="@don_styles.css"
      styleClass="main-bg"
      style="-fx-padding: 14 24 14 24;">

    <!-- Compact Page Header -->
    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="page-header-banner" style="-fx-padding: 10 18;">
        <VBox styleClass="page-header-icon, page-header-icon-green" alignment="CENTER" style="-fx-min-width: 32; -fx-min-height: 32; -fx-max-width: 32; -fx-max-height: 32;">
            <Label text="D" style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: #059669;" />
        </VBox>
        <VBox spacing="1">
            <Label text="Repondre a une Demande" styleClass="page-title" style="-fx-font-size: 18px;" />
            <Label text="Choisissez comment vous souhaitez aider" styleClass="page-subtitle-muted" style="-fx-font-size: 11px;" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Retour" onAction="#handleRetour" styleClass="back-button" />
    </HBox>

    <Label fx:id="errorLabel" visible="false" text="" style="-fx-text-fill: #ef4444; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 4 0 0 0;" />

    <!-- Two-column layout -->
    <HBox spacing="16" VBox.vgrow="ALWAYS" style="-fx-padding: 10 0 0 0;">

        <!-- LEFT: Demande Info Card -->
        <VBox spacing="14" prefWidth="320" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2); -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 16;">
            
            <!-- Title + Badge -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Demande" style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #64748b; -fx-text-transform: uppercase;" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="urgenceBadge" style="-fx-padding: 3 10; -fx-background-radius: 12; -fx-font-size: 11px; -fx-font-weight: 700;" />
            </HBox>
            
            <Label fx:id="demandeTitleLabel" style="-fx-font-size: 17px; -fx-font-weight: 800; -fx-text-fill: #0f172a; -fx-wrap-text: true; -fx-font-family: 'Segoe UI', sans-serif;" wrapText="true" />
            <Label fx:id="demandeDescLabel" style="-fx-text-fill: #475569; -fx-font-size: 13px; -fx-wrap-text: true; -fx-font-family: 'Segoe UI', sans-serif;" wrapText="true" />

            <!-- Divider -->
            <Region style="-fx-background-color: #e2e8f0; -fx-min-height: 1; -fx-max-height: 1;" />

            <!-- Type info -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Type:" style="-fx-font-weight: 700; -fx-text-fill: #475569; -fx-font-size: 12px;" />
                <Label fx:id="typeInfoLabel" style="-fx-font-weight: 700; -fx-text-fill: #0f172a; -fx-font-size: 12px;" />
            </HBox>
            <HBox fx:id="bloodGroupRow" spacing="8" alignment="CENTER_LEFT" visible="false" managed="false">
                <Label text="Groupe:" style="-fx-font-weight: 700; -fx-text-fill: #475569; -fx-font-size: 12px;" />
                <Label fx:id="bloodGroupLabel" style="-fx-font-weight: 800; -fx-text-fill: #dc2626; -fx-font-size: 13px;" />
            </HBox>
            <HBox fx:id="organeRow" spacing="8" alignment="CENTER_LEFT" visible="false" managed="false">
                <Label text="Organe:" style="-fx-font-weight: 700; -fx-text-fill: #475569; -fx-font-size: 12px;" />
                <Label fx:id="organeInfoLabel" style="-fx-font-weight: 800; -fx-text-fill: #7c3aed; -fx-font-size: 13px;" />
            </HBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Compatibility indicator (for blood) -->
            <VBox fx:id="compatibilityBox" visible="false" managed="false" spacing="6" style="-fx-background-color: #f0fdf4; -fx-background-radius: 12; -fx-padding: 12; -fx-border-color: #bbf7d0; -fx-border-width: 1; -fx-border-radius: 12;">
                <Label fx:id="compatibilityLabel" style="-fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #166534;" wrapText="true" />
            </VBox>
        </VBox>

        <!-- RIGHT: Response Form -->
        <VBox spacing="12" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2); -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 16;">

            <!-- Quick Actions -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <VBox styleClass="form-step-badge" alignment="CENTER" style="-fx-min-width: 24; -fx-min-height: 24; -fx-max-width: 24; -fx-max-height: 24;">
                    <Label text="1" styleClass="form-step-number" style="-fx-font-size: 11px;" />
                </VBox>
                <Label text="Action rapide" styleClass="form-step-title" style="-fx-font-size: 13px;" />
            </HBox>

            <HBox fx:id="quickActionsRow" spacing="8" alignment="CENTER_LEFT" />

            <!-- Divider -->
            <Region style="-fx-background-color: #e2e8f0; -fx-min-height: 1; -fx-max-height: 1;" />

            <!-- Blood Group Selection (conditional) -->
            <VBox fx:id="donorBloodSection" visible="false" managed="false" spacing="8">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <VBox styleClass="form-step-badge" alignment="CENTER" style="-fx-min-width: 24; -fx-min-height: 24; -fx-max-width: 24; -fx-max-height: 24;">
                        <Label text="2" styleClass="form-step-number" style="-fx-font-size: 11px;" />
                    </VBox>
                    <Label text="Votre groupe sanguin" styleClass="form-step-title" style="-fx-font-size: 13px;" />
                </HBox>
                <ComboBox fx:id="donorBloodGroup" maxWidth="Infinity" promptText="Selectionnez votre groupe sanguin" styleClass="modern-input">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="A+" />
                            <String fx:value="A-" />
                            <String fx:value="B+" />
                            <String fx:value="B-" />
                            <String fx:value="AB+" />
                            <String fx:value="AB-" />
                            <String fx:value="O+" />
                            <String fx:value="O-" />
                        </FXCollections>
                    </items>
                </ComboBox>
                <Label fx:id="bloodMatchLabel" style="-fx-font-size: 12px; -fx-font-weight: 700;" />
                <Region style="-fx-background-color: #e2e8f0; -fx-min-height: 1; -fx-max-height: 1;" />
            </VBox>

            <!-- Message -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <VBox styleClass="form-step-badge" alignment="CENTER" style="-fx-min-width: 24; -fx-min-height: 24; -fx-max-width: 24; -fx-max-height: 24;">
                    <Label fx:id="messageStepLabel" text="2" styleClass="form-step-number" style="-fx-font-size: 11px;" />
                </VBox>
                <Label text="Message complementaire" styleClass="form-step-title" style="-fx-font-size: 13px;" />
            </HBox>

            <TextArea fx:id="messageArea" promptText="Ajoutez des details supplementaires si necessaire..." prefRowCount="3" styleClass="modern-input" wrapText="true" />

            <!-- Divider -->
            <Region style="-fx-background-color: #e2e8f0; -fx-min-height: 1; -fx-max-height: 1;" />

            <!-- Contact sharing -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <VBox styleClass="form-step-badge" alignment="CENTER" style="-fx-min-width: 24; -fx-min-height: 24; -fx-max-width: 24; -fx-max-height: 24;">
                    <Label fx:id="contactStepLabel" text="3" styleClass="form-step-number" style="-fx-font-size: 11px;" />
                </VBox>
                <Label text="Coordonnees" styleClass="form-step-title" style="-fx-font-size: 13px;" />
            </HBox>

            <CheckBox fx:id="shareContactCheck" text="Partager mes coordonnees avec le demandeur" style="-fx-font-size: 12px; -fx-text-fill: #475569;" />
            <CheckBox fx:id="availableNowCheck" text="Je suis disponible immediatement" style="-fx-font-size: 12px; -fx-text-fill: #475569;" />

            <Region VBox.vgrow="ALWAYS" />

            <!-- Submit -->
            <Button text="Confirmer ma reponse" onAction="#handleValider" maxWidth="Infinity" styleClass="success-button" />
        </VBox>
    </HBox>
</VBox>
