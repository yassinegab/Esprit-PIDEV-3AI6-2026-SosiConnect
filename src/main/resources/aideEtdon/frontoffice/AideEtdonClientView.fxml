<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.aideEtdon.frontoffice.controller.AideEtdonControllerClientController"
            prefHeight="600.0" prefWidth="800.0"
            styleClass="main-bg"
            stylesheets="@aide_styles.css">

    <!-- Top Navigation Bar -->
    <top>
        <HBox alignment="CENTER" spacing="8" styleClass="brand-nav-bar">
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnAides" text="Aides" onAction="#showAides" styleClass="nav-pill, nav-pill-active" />
            <Button fx:id="btnDons" text="Dons" onAction="#showDons" styleClass="nav-pill" />
            <Region HBox.hgrow="ALWAYS" />
        </HBox>
    </top>

    <!-- Center Content Area -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-padding: 30;" BorderPane.alignment="CENTER">
            <!-- Content will be injected dynamically by controller -->
        </StackPane>
    </center>
</BorderPane>
