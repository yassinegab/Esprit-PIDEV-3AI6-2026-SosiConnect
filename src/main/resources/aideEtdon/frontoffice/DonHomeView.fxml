<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.aideEtdon.frontoffice.controller.DonHomeController"
      alignment="CENTER" spacing="40.0"
      stylesheets="@don_styles.css"
      styleClass="main-bg">

    <!-- Page Header Banner -->
    <HBox alignment="CENTER_LEFT" spacing="16" styleClass="page-header-banner" style="-fx-max-width: 960;">
        <VBox styleClass="page-header-icon" alignment="CENTER">
            <Label text="S" styleClass="page-header-icon-label" />
        </VBox>
        <VBox spacing="4">
            <Label text="Centre de Solidarite" styleClass="page-title-accent" />
            <Label text="Demandez de l'aide ou offrez votre soutien a la communaute" styleClass="page-subtitle-muted" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Label text="Plateforme Active" styleClass="badge-pill" />
    </HBox>

    <HBox alignment="CENTER" spacing="32.0">
        <!-- Card 1: Create Request -->
        <VBox fx:id="cardCreate" onMouseClicked="#goToCreateDemande" alignment="CENTER" spacing="14.0" prefWidth="280" prefHeight="260" styleClass="modern-card, card-accent-blue" style="-fx-cursor: hand; -fx-padding: 32;">
            <VBox style="-fx-background-color: linear-gradient(to bottom right, #dbeafe, #eff6ff); -fx-background-radius: 18; -fx-padding: 18; -fx-min-width: 64; -fx-min-height: 64; -fx-max-width: 64; -fx-max-height: 64; -fx-alignment: center;">
                <Label text="+" style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-text-fill: #2563eb;" />
            </VBox>
            <Label text="Nouvelle Demande" style="-fx-font-size: 17px; -fx-font-weight: 800; -fx-text-fill: #0f172a; -fx-font-family: 'Segoe UI', sans-serif;" />
            <Label text="Soumettez une demande d'aide medicale ou materielle" style="-fx-text-fill: #64748b; -fx-font-size: 13px; -fx-wrap-text: true; -fx-text-alignment: center; -fx-max-width: 220; -fx-font-family: 'Segoe UI', sans-serif;" />
            <Label text="Creer" style="-fx-background-color: #eff6ff; -fx-text-fill: #2563eb; -fx-padding: 4 14; -fx-background-radius: 16; -fx-font-weight: 700; -fx-font-size: 11px; -fx-border-color: #bfdbfe; -fx-border-width: 1; -fx-border-radius: 16;" />
        </VBox>

        <!-- Card 2: View Requests -->
        <VBox fx:id="cardView" onMouseClicked="#goToViewDemandes" alignment="CENTER" spacing="14.0" prefWidth="280" prefHeight="260" styleClass="modern-card, card-accent-green" style="-fx-cursor: hand; -fx-padding: 32;">
            <VBox style="-fx-background-color: linear-gradient(to bottom right, #d1fae5, #ecfdf5); -fx-background-radius: 18; -fx-padding: 18; -fx-min-width: 64; -fx-min-height: 64; -fx-max-width: 64; -fx-max-height: 64; -fx-alignment: center;">
                <Label text="=" style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-text-fill: #059669;" />
            </VBox>
            <Label text="Consulter les Demandes" style="-fx-font-size: 17px; -fx-font-weight: 800; -fx-text-fill: #0f172a; -fx-font-family: 'Segoe UI', sans-serif;" />
            <Label text="Parcourez et repondez aux appels a l'aide" style="-fx-text-fill: #64748b; -fx-font-size: 13px; -fx-wrap-text: true; -fx-text-alignment: center; -fx-max-width: 220; -fx-font-family: 'Segoe UI', sans-serif;" />
            <Label text="Explorer" style="-fx-background-color: #ecfdf5; -fx-text-fill: #059669; -fx-padding: 4 14; -fx-background-radius: 16; -fx-font-weight: 700; -fx-font-size: 11px; -fx-border-color: #a7f3d0; -fx-border-width: 1; -fx-border-radius: 16;" />
        </VBox>

        <!-- Card 3: Videos -->
        <VBox fx:id="cardVideo" onMouseClicked="#goToVideos" alignment="CENTER" spacing="14.0" prefWidth="280" prefHeight="260" styleClass="modern-card, card-accent-red" style="-fx-cursor: hand; -fx-padding: 32;">
            <VBox style="-fx-background-color: linear-gradient(to bottom right, #fee2e2, #fef2f2); -fx-background-radius: 18; -fx-padding: 18; -fx-min-width: 64; -fx-min-height: 64; -fx-max-width: 64; -fx-max-height: 64; -fx-alignment: center;">
                <Label text=">" style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-text-fill: #dc2626;" />
            </VBox>
            <Label text="Sensibilisation" style="-fx-font-size: 17px; -fx-font-weight: 800; -fx-text-fill: #0f172a; -fx-font-family: 'Segoe UI', sans-serif;" />
            <Label text="Regardez des videos educatives sur le don et l'entraide" style="-fx-text-fill: #64748b; -fx-font-size: 13px; -fx-wrap-text: true; -fx-text-alignment: center; -fx-max-width: 220; -fx-font-family: 'Segoe UI', sans-serif;" />
            <Label text="Regarder" style="-fx-background-color: #fef2f2; -fx-text-fill: #dc2626; -fx-padding: 4 14; -fx-background-radius: 16; -fx-font-weight: 700; -fx-font-size: 11px; -fx-border-color: #fecaca; -fx-border-width: 1; -fx-border-radius: 16;" />
        </VBox>
    </HBox>

    <!-- Info Tip -->
    <HBox alignment="CENTER" spacing="8" styleClass="info-tip-bar" style="-fx-max-width: 640;">
        <Label text="i" style="-fx-font-size: 14px; -fx-font-weight: 900; -fx-text-fill: #0d9488;" />
        <Label text="Selectionnez une action pour commencer. Vos demandes sont traitees en priorite." styleClass="info-tip-text" />
    </HBox>
</VBox>
