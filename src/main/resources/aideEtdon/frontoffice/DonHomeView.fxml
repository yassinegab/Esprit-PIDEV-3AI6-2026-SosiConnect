<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.aideEtdon.frontoffice.controller.DonHomeController"
      alignment="CENTER" spacing="32"
      stylesheets="@don_styles.css"
      styleClass="main-bg">

    <!-- Page Header Banner with emoji -->
    <HBox alignment="CENTER_LEFT" spacing="16" styleClass="page-header-banner" style="-fx-max-width: 960;">
        <VBox styleClass="page-header-icon" alignment="CENTER">
            <Label text="🤝" style="-fx-font-size: 26px;" />
        </VBox>
        <VBox spacing="4">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Centre de Solidarite" styleClass="page-title-accent" />
                <Label text="💚" style="-fx-font-size: 22px;" />
            </HBox>
            <Label text="Demandez de l'aide ou offrez votre soutien a la communaute" styleClass="page-subtitle-muted" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Label text="🟢 Plateforme Active" styleClass="badge-pill" />
    </HBox>

    <HBox alignment="CENTER" spacing="28">
        <!-- Card 1: Create Request -->
        <VBox fx:id="cardCreate" onMouseClicked="#goToCreateDemande" alignment="CENTER" spacing="12" prefWidth="270" prefHeight="280" styleClass="modern-card, card-accent-blue" style="-fx-cursor: hand; -fx-padding: 28;">
            <VBox style="-fx-background-color: linear-gradient(to bottom right, #dbeafe, #eff6ff); -fx-background-radius: 22; -fx-padding: 16; -fx-min-width: 68; -fx-min-height: 68; -fx-max-width: 68; -fx-max-height: 68; -fx-alignment: center;">
                <Label text="📝" style="-fx-font-size: 30px;" />
            </VBox>
            <Label text="Nouvelle Demande" style="-fx-font-size: 17px; -fx-font-weight: 800; -fx-text-fill: #0f172a; -fx-font-family: 'Segoe UI', sans-serif;" />
            <Label text="Soumettez une demande d'aide medicale ou materielle" style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-wrap-text: true; -fx-text-alignment: center; -fx-max-width: 220; -fx-font-family: 'Segoe UI', sans-serif;" wrapText="true" />
            <Region VBox.vgrow="ALWAYS" />
            <Label text="➕ Creer" style="-fx-background-color: #eff6ff; -fx-text-fill: #2563eb; -fx-padding: 6 18; -fx-background-radius: 16; -fx-font-weight: 700; -fx-font-size: 12px; -fx-border-color: #bfdbfe; -fx-border-width: 1; -fx-border-radius: 16;" />
        </VBox>

        <!-- Card 2: View Requests -->
        <VBox fx:id="cardView" onMouseClicked="#goToViewDemandes" alignment="CENTER" spacing="12" prefWidth="270" prefHeight="280" styleClass="modern-card, card-accent-green" style="-fx-cursor: hand; -fx-padding: 28;">
            <VBox style="-fx-background-color: linear-gradient(to bottom right, #d1fae5, #ecfdf5); -fx-background-radius: 22; -fx-padding: 16; -fx-min-width: 68; -fx-min-height: 68; -fx-max-width: 68; -fx-max-height: 68; -fx-alignment: center;">
                <Label text="🔍" style="-fx-font-size: 30px;" />
            </VBox>
            <Label text="Consulter les Demandes" style="-fx-font-size: 17px; -fx-font-weight: 800; -fx-text-fill: #0f172a; -fx-font-family: 'Segoe UI', sans-serif;" />
            <Label text="Parcourez et repondez aux appels a l'aide" style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-wrap-text: true; -fx-text-alignment: center; -fx-max-width: 220; -fx-font-family: 'Segoe UI', sans-serif;" wrapText="true" />
            <Region VBox.vgrow="ALWAYS" />
            <Label text="🔎 Explorer" style="-fx-background-color: #ecfdf5; -fx-text-fill: #059669; -fx-padding: 6 18; -fx-background-radius: 16; -fx-font-weight: 700; -fx-font-size: 12px; -fx-border-color: #a7f3d0; -fx-border-width: 1; -fx-border-radius: 16;" />
        </VBox>

        <!-- Card 3: Videos -->
        <VBox fx:id="cardVideo" onMouseClicked="#goToVideos" alignment="CENTER" spacing="12" prefWidth="270" prefHeight="280" styleClass="modern-card, card-accent-red" style="-fx-cursor: hand; -fx-padding: 28;">
            <VBox style="-fx-background-color: linear-gradient(to bottom right, #fee2e2, #fef2f2); -fx-background-radius: 22; -fx-padding: 16; -fx-min-width: 68; -fx-min-height: 68; -fx-max-width: 68; -fx-max-height: 68; -fx-alignment: center;">
                <Label text="🎬" style="-fx-font-size: 30px;" />
            </VBox>
            <Label text="Sensibilisation" style="-fx-font-size: 17px; -fx-font-weight: 800; -fx-text-fill: #0f172a; -fx-font-family: 'Segoe UI', sans-serif;" />
            <Label text="Regardez des videos educatives sur le don et l'entraide" style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-wrap-text: true; -fx-text-alignment: center; -fx-max-width: 220; -fx-font-family: 'Segoe UI', sans-serif;" wrapText="true" />
            <Region VBox.vgrow="ALWAYS" />
            <Label text="▶ Regarder" style="-fx-background-color: #fef2f2; -fx-text-fill: #dc2626; -fx-padding: 6 18; -fx-background-radius: 16; -fx-font-weight: 700; -fx-font-size: 12px; -fx-border-color: #fecaca; -fx-border-width: 1; -fx-border-radius: 16;" />
        </VBox>
    </HBox>

    <!-- Stats Marquee -->
    <HBox alignment="CENTER" spacing="24" style="-fx-max-width: 700;">
        <VBox alignment="CENTER" spacing="2" style="-fx-background-color: #f0fdf4; -fx-background-radius: 14; -fx-padding: 12 24; -fx-border-color: #bbf7d0; -fx-border-width: 1; -fx-border-radius: 14;">
            <Label text="🩸" style="-fx-font-size: 20px;" />
            <Label text="Don de Sang" style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #16a34a;" />
        </VBox>
        <VBox alignment="CENTER" spacing="2" style="-fx-background-color: #eff6ff; -fx-background-radius: 14; -fx-padding: 12 24; -fx-border-color: #bfdbfe; -fx-border-width: 1; -fx-border-radius: 14;">
            <Label text="🫁" style="-fx-font-size: 20px;" />
            <Label text="Don d'Organe" style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #2563eb;" />
        </VBox>
        <VBox alignment="CENTER" spacing="2" style="-fx-background-color: #fef3c7; -fx-background-radius: 14; -fx-padding: 12 24; -fx-border-color: #fde68a; -fx-border-width: 1; -fx-border-radius: 14;">
            <Label text="💊" style="-fx-font-size: 20px;" />
            <Label text="Medicaments" style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #d97706;" />
        </VBox>
        <VBox alignment="CENTER" spacing="2" style="-fx-background-color: #fce7f3; -fx-background-radius: 14; -fx-padding: 12 24; -fx-border-color: #fbcfe8; -fx-border-width: 1; -fx-border-radius: 14;">
            <Label text="❤️" style="-fx-font-size: 20px;" />
            <Label text="Solidarite" style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #db2777;" />
        </VBox>
    </HBox>

    <!-- Info Tip -->
    <HBox alignment="CENTER" spacing="8" styleClass="info-tip-bar" style="-fx-max-width: 640;">
        <Label text="💡" style="-fx-font-size: 16px;" />
        <Label text="Selectionnez une action pour commencer. Vos demandes sont traitees en priorite." styleClass="info-tip-text" />
    </HBox>
</VBox>
