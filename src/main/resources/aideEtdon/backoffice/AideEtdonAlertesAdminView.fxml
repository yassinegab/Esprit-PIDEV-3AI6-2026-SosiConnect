<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.aideEtdon.backoffice.AideEtdonAlertesAdminController"
      stylesheets="@admin_don_styles.css"
      style="-fx-padding: 20; -fx-background-color: transparent;" spacing="20">

    <VBox spacing="6">
        <Label text="Centre d'Intervention d'Urgences" styleClass="dashboard-header" />
        <Label text="Tableau de bord des alertes d'urgence en temps réel" styleClass="dashboard-subheader" />
    </VBox>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox spacing="4">
            <Label text="Alertes Actives" style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #b91c1c;" />
            <Label text="Ce tableau recueille en temps réel les pressions du bouton d'urgence" style="-fx-text-fill: #64748b; -fx-font-size: 13px;" />
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Rafraîchir les Alertes" onAction="#loadAlertes" styleClass="danger-button" />
        <Button text="Exporter PDF" onAction="#handleExportPdf" styleClass="success-admin-button" />
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
        <VBox fx:id="alertesListContainer" spacing="12" style="-fx-padding: 4;" />
    </ScrollPane>

</VBox>
