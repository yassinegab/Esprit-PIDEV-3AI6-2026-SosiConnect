<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.*?>
<?import javafx.scene.control.*?>

<VBox prefHeight="700.0" prefWidth="950.0" style="-fx-background-color: #f8f9fb;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.cycle.frontoffice.controller.GoogleCalendarWebController">
    
    <HBox style="-fx-padding: 20 30; -fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;" spacing="20" alignment="CENTER_LEFT">
        <Button onAction="#goBack" style="-fx-background-color: #f1f5f9; -fx-background-radius: 10; -fx-cursor: hand;" text="← Retour" />
        <VBox spacing="5">
            <Label style="-fx-font-size: 22px; -fx-font-weight: 900; -fx-text-fill: #1e293b;" text="📅 Mon Agenda Google" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: #64748b;" text="Visualisez vos cycles et rendez-vous synchronisés" />
        </VBox>
    </HBox>

    <StackPane VBox.vgrow="ALWAYS">
        <WebView fx:id="webView" />
        <ProgressIndicator fx:id="progressIndicator" maxHeight="50" maxWidth="50" visible="false" />
    </StackPane>

</VBox>
