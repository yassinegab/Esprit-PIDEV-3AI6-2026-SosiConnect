<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Separator?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="900.0" styleClass="main-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.cycle.frontoffice.controller.DisplaySymptomeController">

    <stylesheets>
        <URL value="@DisplayCss.css" />
    </stylesheets>

    <!-- HEADER SECTION -->
    <HBox styleClass="header-container" alignment="CENTER_LEFT">
        <Label styleClass="header-title" text="Carnet de Symptômes" />
        
        <!-- PUSH BUTTONS TO RIGHT -->
        <Pane HBox.hgrow="ALWAYS" />
        
        <HBox spacing="10">
            <Button fx:id="btnAddSymptom" onAction="#goToAddSymptom" styleClass="btn-primary" text="+ Nouveau Symptôme" />
        </HBox>
    </HBox>

    <!-- CONTENT SECTION -->
    <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" pannable="true" styleClass="custom-scroll" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
        <content>
            <VBox alignment="TOP_CENTER" spacing="15" style="-fx-padding: 20;">
                
                <!-- 🧠 AI ADVICE SECTION -->
                <VBox fx:id="adviceContainer" styleClass="cycle-card" prefWidth="850" spacing="10" style="-fx-background-color: #ffffff; -fx-border-color: #fee2e2; -fx-border-radius: 15; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                    <Label text="✨ Conseils Intelligents du Jour" style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #dc3545;" />
                    <Label fx:id="lblPhase" text="Phase : Chargement..." style="-fx-font-style: italic; -fx-text-fill: #7f8c8d;" />
                    <HBox spacing="20">
                        <VBox spacing="5" HBox.hgrow="ALWAYS" prefWidth="200">
                            <Label text="🍎 Alimentation" style="-fx-font-weight: bold; -fx-text-fill: #e74c3c;" />
                            <Label fx:id="lblAlimentation" text="..." wrapText="true" style="-fx-text-fill: #333333;" />
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS" prefWidth="200">
                            <Label text="🏃‍♀️ Activité Physique" style="-fx-font-weight: bold; -fx-text-fill: #27ae60;" />
                            <Label fx:id="lblSport" text="..." wrapText="true" style="-fx-text-fill: #333333;" />
                        </VBox>
                    </HBox>
                    <HBox spacing="20">
                        <VBox spacing="5" HBox.hgrow="ALWAYS" prefWidth="200">
                            <Label text="🧘‍♀️ Bien-être" style="-fx-font-weight: bold; -fx-text-fill: #f39c12;" />
                            <Label fx:id="lblBienEtre" text="..." wrapText="true" style="-fx-text-fill: #333333;" />
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS" prefWidth="200">
                            <Label text="💡 Résumé" style="-fx-font-weight: bold; -fx-text-fill: #2980b9;" />
                            <Label fx:id="lblResume" text="..." wrapText="true" style="-fx-text-fill: #333333;" />
                        </VBox>
                    </HBox>
                </VBox>

                <!-- ➕ INTEGRATED ADD SYMPTOM FORM -->
                <VBox spacing="15" styleClass="cycle-card" prefWidth="850" style="-fx-background-color: #ffffff; -fx-border-color: #f1f5f9; -fx-border-radius: 15; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                    <Label text="Ajouter un Symptôme" style="-fx-font-size: 16px; -fx-font-weight: 800; -fx-text-fill: #1e293b;" />
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Type" style="-fx-font-size: 12px; -fx-text-fill: #64748b;" />
                            <ComboBox fx:id="typeComboBox" promptText="Type..." maxWidth="1.7976931348623157E308" />
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Intensité" style="-fx-font-size: 12px; -fx-text-fill: #64748b;" />
                            <ComboBox fx:id="intensiteComboBox" promptText="Intensité..." maxWidth="1.7976931348623157E308" />
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Date" style="-fx-font-size: 12px; -fx-text-fill: #64748b;" />
                            <DatePicker fx:id="datePicker" maxWidth="1.7976931348623157E308" />
                        </VBox>
                        <Button onAction="#handleInlineAddSymptome" text="Enregistrer" styleClass="btn-primary-cycle" prefHeight="40">
                             <HBox.margin>
                                <Insets top="18"/>
                             </HBox.margin>
                        </Button>
                    </HBox>
                </VBox>

                <Separator style="-fx-padding: 10 0 10 0;" />
                <FlowPane fx:id="symptomeContainer" hgap="25" prefWrapLength="850" styleClass="cycle-container" vgap="25" />
            </VBox>
        </content>
    </ScrollPane>

</VBox>
