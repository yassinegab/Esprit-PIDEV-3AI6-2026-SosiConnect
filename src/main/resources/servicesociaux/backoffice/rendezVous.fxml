<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<ScrollPane fitToWidth="true"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.servicesociaux.backoffice.controllers.RendezVousController"
            styleClass="admin-view-bg">

    <stylesheets>
        <URL value="@admin_services.css"/>
    </stylesheets>

    <VBox spacing="0" styleClass="admin-view-bg">

        <!-- ═══ HEADER ADMIN ══════════════════════════════════════ -->
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="admin-header-strip">
            <Button text="←" onAction="#retourAccueil"
                    style="-fx-background-color: rgba(255,255,255,0.1);
                           -fx-text-fill: white;
                           -fx-background-radius: 50;
                           -fx-font-size: 14; -fx-font-weight: bold;
                           -fx-padding: 4 13;
                           -fx-cursor: hand;"/>
            <Label text="📅  Gestion des Rendez-vous — Administration"
                   style="-fx-font-size: 16; -fx-font-weight: 800;
                          -fx-text-fill: white;" HBox.hgrow="ALWAYS"/>
            <Label text="Backoffice"
                   style="-fx-text-fill: rgba(255,255,255,0.4); -fx-font-size: 11; -fx-font-weight: 600;"/>
        </HBox>

        <VBox spacing="16" style="-fx-padding: 24;">

            <!-- ═══ STATISTIQUES ══════════════════════════════════ -->
            <HBox spacing="12">
                <VBox HBox.hgrow="ALWAYS" styleClass="stat-card-admin, stat-card-total">
                    <Label text="TOTAL RDV" styleClass="stat-label-small"/>
                    <Label fx:id="statTotal" text="0" styleClass="stat-value-large"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" styleClass="stat-card-admin, stat-card-warning">
                    <Label text="EN ATTENTE" styleClass="stat-label-small"/>
                    <Label fx:id="statEnAttente" text="0" styleClass="stat-value-large"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" styleClass="stat-card-admin, stat-card-success">
                    <Label text="CONFIRMÉS" styleClass="stat-label-small"/>
                    <Label fx:id="statConfirme" text="0" styleClass="stat-value-large"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" styleClass="stat-card-admin, stat-card-purple">
                    <Label text="TERMINÉS" styleClass="stat-label-small"/>
                    <Label fx:id="statTermine" text="0" styleClass="stat-value-large"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" styleClass="stat-card-admin, stat-card-danger">
                    <Label text="ANNULÉS" styleClass="stat-label-small"/>
                    <Label fx:id="statAnnule" text="0" styleClass="stat-value-large"/>
                </VBox>
            </HBox>

            <!-- ═══ LAYOUT : FORMULAIRE | TABLEAU ════════════════ -->
            <HBox spacing="16" VBox.vgrow="ALWAYS">

                <!-- ── PANNEAU MODIFICATION (gauche) ─────────────── -->
                <VBox spacing="12" prefWidth="280" styleClass="admin-side-panel">
                    <Label text="Modifier un rendez-vous" style="-fx-font-size: 14; -fx-font-weight: 800; -fx-text-fill: #1e293b;"/>
                    
                    <Label fx:id="labelSelectedId" text="Aucun rendez-vous sélectionné" wrapText="true"
                           style="-fx-font-size: 11; -fx-text-fill: #94a3b8; -fx-background-color: #f8fafc; -fx-padding: 8; -fx-background-radius: 6;"/>

                    <Separator/>

                    <VBox spacing="5">
                        <Label text="Statut *" styleClass="admin-field-label"/>
                        <ComboBox fx:id="fieldStatut" maxWidth="Infinity" promptText="Choisir le statut..."
                                  disable="true" styleClass="admin-input-small"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Notes" styleClass="admin-field-label"/>
                        <TextArea fx:id="fieldNotes" prefRowCount="4" promptText="Remarques..."
                                  disable="true" wrapText="true" styleClass="admin-input-small"/>
                    </VBox>

                    <Region VBox.vgrow="ALWAYS"/>

                    <Button fx:id="btnModifier" text="✎ Enregistrer" onAction="#modifier"
                            maxWidth="Infinity" disable="true" styleClass="btn-admin-primary"/>

                    <Button fx:id="btnSupprimer" text="✕ Supprimer" onAction="#supprimer"
                            maxWidth="Infinity" disable="true" styleClass="btn-admin-danger"/>

                    <Button fx:id="btnVider" text="↺ Désélectionner" onAction="#viderFormulaire"
                            maxWidth="Infinity" disable="true" styleClass="btn-admin-outline"/>

                    <Label fx:id="errorLabel" wrapText="true" style="-fx-font-size: 11; -fx-text-fill: #ef4444;"/>
                </VBox>

                <!-- ── TABLEAU + FILTRES (droite) ────────────────── -->
                <VBox spacing="12" HBox.hgrow="ALWAYS">
                    <VBox spacing="10" styleClass="admin-side-panel">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="searchField" promptText="Rechercher..." HBox.hgrow="ALWAYS" styleClass="admin-input-small"/>
                            <Button text="⬇ Export CSV" onAction="#exporterCSV" styleClass="btn-admin-primary" style="-fx-font-size: 11;"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <ComboBox fx:id="filterStatut" promptText="Statut" styleClass="admin-input-small" prefWidth="120"/>
                            <ComboBox fx:id="filterType" promptText="Type" styleClass="admin-input-small" prefWidth="120"/>
                            <ComboBox fx:id="filterHopital" promptText="Hôpital" styleClass="admin-input-small" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        </HBox>
                    </VBox>

                    <TableView fx:id="tableView" VBox.vgrow="ALWAYS" styleClass="admin-table">
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                            <TableColumn fx:id="colPatient" text="Patient" prefWidth="80"/>
                            <TableColumn fx:id="colHopital" text="Hôpital" prefWidth="150"/>
                            <TableColumn fx:id="colType" text="Type" prefWidth="110"/>
                            <TableColumn fx:id="colStatut" text="Statut" prefWidth="90"/>
                            <TableColumn fx:id="colDate" text="Date &amp; Heure" prefWidth="140"/>
                            <TableColumn fx:id="colNotes" text="Notes" prefWidth="160"/>
                        </columns>
                    </TableView>
                </VBox>
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>
